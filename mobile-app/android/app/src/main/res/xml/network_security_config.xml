<?xml version="1.0" encoding="utf-8"?>
<!--
    flutter_3d_controller renders .glb models by spinning up a local HTTP server
    on 127.0.0.1. Android API 28+ blocks cleartext traffic by default, so we
    must explicitly whitelist localhost here. This does NOT permit cleartext to
    any external domain.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
